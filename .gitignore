dist/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Prisma generated client (regenerated with `pnpm db:generate`)
apps/api/src/generated/

# Logs and OS files
*.log
.DS_Store
Thumbs.db
*.pem

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
