# Optional. Copy to apps/web/.env.local only if the API is not on the default URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Mobile app download page (/download). An https link to the Android APK (EAS build or GitHub
# release) and its version; read on each request (a restart picks up a change).
# ANDROID_APK_URL=
# ANDROID_APP_VERSION=0.1.0
