{
  "name": "@nuvora/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Faroz native app (Expo, React Native). Uses the NestJS API and the shared Zod contracts.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tokens": "node scripts/gen-tokens.mjs",
    "typecheck": "node scripts/gen-tokens.mjs --check && tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "bundle:android": "expo export --platform android --output-dir dist-check --no-minify"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/unbounded": "0.4.1",
    "@expo/metro-runtime": "58.0.15",
    "@nuvora/shared": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.21",
    "expo-blur": "58.0.5",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.15",
    "expo-local-authentication": "58.0.2",
    "expo-localization": "58.0.5",
    "expo-network": "58.0.4",
    "expo-notifications": "58.1.7",
    "expo-router": "58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "lucide-react-native": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
