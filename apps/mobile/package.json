{
  "name": "@nuvora/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Faroz native app (Expo, React Native). Uses the NestJS API and the shared Zod contracts.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tokens": "node scripts/gen-tokens.mjs",
    "typecheck": "node scripts/gen-tokens.mjs --check && tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "bundle:android": "expo export --platform android --output-dir dist-check --no-minify"
  },
  "dependencies": {
    "@nuvora/shared": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.21",
    "expo-constants": "58.0.14",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.15",
    "expo-local-authentication": "58.0.2",
    "expo-localization": "58.0.5",
    "expo-network": "58.0.4",
    "expo-router": "58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
