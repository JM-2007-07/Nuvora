{
  "expo": {
    "name": "Faroz",
    "slug": "faroz",
    "owner": "asiljms-team",
    "scheme": "faroz",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0A0B14",
    "newArchEnabled": true,
    "android": {
      "package": "tj.faroz.app",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#0A0B14" },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "tj.faroz.app",
      "supportsTablet": true,
      "infoPlist": { "NSFaceIDUsageDescription": "Faroz uses Face ID to unlock the app on this device. Your face data stays with iOS." }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      ["expo-local-authentication", { "faceIDPermission": "Faroz uses Face ID to unlock the app on this device. Your face data stays with iOS." }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "apiUrl": null, "eas": { "projectId": "fe231c6a-f872-4754-859e-2a2af8ef4116" } }
  }
}
