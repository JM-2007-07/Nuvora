# Copy this file to apps/api/.env and replace CHANGE_ME with your local password.
# Never commit .env. It is git-ignored.
# The role and databases are created by the owner (see README "Getting started").

DATABASE_URL="postgresql://nuvora:CHANGE_ME@localhost:5432/nuvora_dev?schema=public"
DATABASE_URL_TEST="postgresql://nuvora:CHANGE_ME@localhost:5432/nuvora_test?schema=public"
SHADOW_DATABASE_URL="postgresql://nuvora:CHANGE_ME@localhost:5432/nuvora_shadow?schema=public"

# Signs the learner session cookie. Any random string of 32+ characters.
# Optional for local development: without it, sessions reset when the API restarts.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Push notifications (D-30). "log" (default) only logs and sends nothing. "expo" sends through the
# Expo push service and needs an app build with push credentials (Android: Firebase/FCM in the EAS project).
# PUSH_DELIVERY=log
# Only when "enhanced push security" is turned on for the Expo project:
# EXPO_ACCESS_TOKEN=
# "on" runs scheduled notifications (reminders, upcoming tests, weekly summaries) every 10 minutes:
# PUSH_SCHEDULER=off

# AI assistant (D-32). Key from Google AI Studio with Cloud Billing on (the free tier may be used to
# improve Google's products, and a Gemini subscription does not include API use).
# GEMINI_API_KEY=CHANGE_ME
# "mock": canned answers without network, for checking screens locally. Refused in production.
# AI_PROVIDER=mock
# "on" also opens the assistant to demo profiles (they have no date of birth).
# AI_DEMO_PROFILES=off
# Models (one id or a comma-separated fallback list). Defaults: gemini-3.6-flash, then a lighter one.
# AI_MODEL_CHAT=gemini-3.6-flash,gemini-3.5-flash-lite
# AI_MODEL_GENERATE=gemini-3.6-flash,gemini-3.5-flash
# Requests per day across the platform, the hard stop for the bill (default 1000).
# AI_DAILY_LIMIT=1000

# Hosting (docs/engineering/DEPLOYMENT.md). Demo sign-in without passwords: on by default locally,
# off with NODE_ENV=production unless set to "on" (the hosted defense demo).
# DEMO_LOGINS=on
# Behind a hosting proxy (Render, nginx): read the client address from X-Forwarded-For.
# TRUST_PROXY=off
# Start script data steps (scripts/render-start.mjs): off | content | demo | reset-demo
# SEED_ON_START=demo
