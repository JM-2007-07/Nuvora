// Nuvora database schema (Prisma 7.10.1), Gate G2.
// Spec: docs/04-data/data-model.md. MVP entities only, no "Later" tables.
// The connection URL lives in prisma.config.ts.
//
// Conventions:
// - ids are cuid strings; tables are snake_case plural (@@map).
// - Localized text is jsonb `{ tg, ru, en }`, validated with Zod (ADR-0003).
// - Content slugs are unique per entity type; questions, options and resources
//   have keys unique within their parent, so re-seeding upserts instead of duplicating.
// - Deletion policy (data-model.md#deletion-policy): content deletes cascade to other
//   content, but every learner-history row references content with ON DELETE RESTRICT,
//   so content with history cannot be deleted. Deleting a user cascades to their history.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (must match packages/shared/src/enums.ts) ----------

enum Locale {
  tg
  ru
  en
}

enum UserKind {
  DEMO
  GUEST
  /// A learner who registered with email and password (Account.role LEARNER)
  ACCOUNT
}

/// Faroz accounts (2026-10-28, owner-approved migration): who signs in with a password.
enum AccountRole {
  LEARNER
  TEACHER
  CENTER_ADMIN
}

/// Faroz plans (handoff pricing). Payments are a demo: nothing is charged.
enum PlanCode {
  FREE
  TEACHER
  CENTER
}

enum QuizKind {
  TOPIC
  CHECKPOINT
}

enum QuestionType {
  SINGLE_CHOICE
}

enum ResourceType {
  BOOK
  ARTICLE
  VIDEO
  EXERCISE
}

enum MasteryStatus {
  NOT_STARTED
  WEAK
  DEVELOPING
  MASTERED
}

// ---------- Content (authored in seed files, read-only at runtime) ----------

model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       Json
  description Json
  order       Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics  Topic[]
  quizzes Quiz[]

  @@map("subjects")
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  slug      String   @unique
  title     Json
  summary   Json
  order     Int
  /// Knowledge Map column (prerequisite depth), D-09
  mapX      Int
  /// Knowledge Map row within the column
  mapY      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject       Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// Rows where this topic requires another topic
  prerequisites TopicPrerequisite[] @relation("TopicRequires")
  /// Rows where this topic is required by another topic
  dependents    TopicPrerequisite[] @relation("TopicRequiredBy")
  lessons       Lesson[]
  resources     Resource[]
  quizzes       Quiz[]
  questions     Question[]
  masteries     TopicMastery[]

  @@index([subjectId, order])
  @@map("topics")
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic        Topic @relation("TopicRequires", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite Topic @relation("TopicRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("topic_prerequisites")
}

model Lesson {
  id               String   @id @default(cuid())
  topicId          String
  slug             String   @unique
  title            Json
  /// Markdown per locale (D-12)
  body             Json
  estimatedMinutes Int
  order            Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  topic    Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([topicId, order])
  @@map("lessons")
}

model Resource {
  id        String       @id @default(cuid())
  topicId   String
  key       String
  type      ResourceType
  title     Json
  author    String
  url       String?
  /// Languages the resource itself is available in
  languages Locale[]
  whyUseful Json
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, key])
  @@map("resources")
}

model Quiz {
  id        String   @id @default(cuid())
  subjectId String
  /// Set for TOPIC quizzes; null for a CHECKPOINT quiz spanning several topics
  topicId   String?
  slug      String   @unique
  title     Json
  kind      QuizKind
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic     Topic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([subjectId])
  @@index([topicId])
  @@map("quizzes")
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  /// The topic this question assesses (drives weak-topic analysis)
  topicId     String
  key         String
  type        QuestionType @default(SINGLE_CHOICE)
  /// Markdown per locale
  prompt      Json
  /// Markdown per locale
  explanation Json
  order       Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic   Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options AnswerOption[]
  answers AttemptAnswer[]

  @@unique([quizId, key])
  @@index([topicId])
  @@map("questions")
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  key        String
  text       Json
  /// Never sent to clients before submission (FR-QUIZ-06)
  isCorrect  Boolean
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@unique([questionId, key])
  @@map("answer_options")
}

// ---------- Learner data (written at runtime) ----------

model User {
  id              String   @id @default(cuid())
  kind            UserKind
  /// Set for seeded demo learners only (ADR-0006)
  demoSlug        String?  @unique
  displayName     String
  preferredLocale Locale?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempts       QuizAttempt[]
  masteries      TopicMastery[]
  lessonProgress LessonProgress[]
  account        Account?
  memberships    GroupMember[]

  @@map("users")
}

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  submittedAt  DateTime @default(now())
  correctCount Int
  totalCount   Int
  /// Integer 0–100
  scorePercent Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: content deletion must never erase learner history (deletion policy, data-model.md)
  quiz      Quiz            @relation(fields: [quizId], references: [id], onDelete: Restrict)
  answers   AttemptAnswer[]
  masteries TopicMastery[]

  @@index([userId, submittedAt])
  @@index([quizId])
  @@map("quiz_attempts")
}

model AttemptAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  /// Stored at scoring time so history survives later content edits
  isCorrect        Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempt        QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// Restrict: content deletion must never erase learner history (deletion policy, data-model.md)
  question       Question      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption AnswerOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("attempt_answers")
}

model TopicMastery {
  id            String        @id @default(cuid())
  userId        String
  topicId       String
  /// Integer 0–100, from the latest attempt that included the topic (ADR-0004)
  scorePercent  Int
  status        MasteryStatus
  lastAttemptId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: content deletion must never erase learner history (deletion policy, data-model.md)
  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Restrict)
  lastAttempt QuizAttempt? @relation(fields: [lastAttemptId], references: [id], onDelete: SetNull)

  @@unique([userId, topicId])
  @@index([topicId])
  @@map("topic_masteries")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: content deletion must never erase learner history (deletion policy, data-model.md)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ---------- Accounts, organizations, plans, groups (Faroz, 2026-10-28) ----------
// Password accounts sit next to the demo profiles (which stay for the defense demo).
// A learner account owns a User row, so attempts, mastery and progress work unchanged.

model Account {
  id             String        @id @default(cuid())
  /// Stored lower-case; unique sign-in name
  email          String        @unique
  /// scrypt: "<salt hex>:<key hex>" (node:crypto, no extra package)
  passwordHash   String
  name           String
  role           AccountRole
  /// Learner accounts only: their learning history
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Teacher (own workspace) or center admin: the organization that holds the plan
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  teaching            StudyGroup[]
  acceptedInvitations StaffInvitation[]

  @@index([organizationId])
  @@map("accounts")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  subscriptions Subscription[]
  groups        StudyGroup[]

  @@map("organizations")
}

/// A demo checkout: records the chosen plan; no money moves (isDemo is always true here).
model Subscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           PlanCode
  priceCents     Int
  currency       String
  isDemo         Boolean      @default(true)
  startedAt      DateTime     @default(now())
  renewsAt       DateTime

  @@index([organizationId])
  @@map("subscriptions")
}

/// A group created by a teacher or center; learners join with its code.
model StudyGroup {
  id               String       @id @default(cuid())
  /// Short join code shown to the teacher, e.g. "JS-4K7Q"
  joinCode         String       @unique
  name             String
  subjectSlug      String
  capacity         Int
  schedule         String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacherAccountId String?
  teacher          Account?     @relation(fields: [teacherAccountId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  // ----- Center group wizard (2026-10-29, owner-approved migration); empty for older groups -----
  /// The center's own code, e.g. "B-18" (unique within the organization)
  displayCode      String?
  startsOn         DateTime?
  /// Teaching languages
  languages        Locale[]
  /// Who teaches it: demo staff slug ("dilshod-karimov") or "acct:<accountId>"; null = assign later
  teacherKey       String?
  teacherName      String?

  members GroupMember[]

  @@unique([organizationId, displayCode])
  @@index([organizationId])
  @@index([teacherAccountId])
  @@index([teacherKey])
  @@map("study_groups")
}

model GroupMember {
  groupId  String
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now())

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ---------- Teacher assessments (Faroz, 2026-10-29, owner-approved migration) ----------
// Checks, retests and diagnostics a teacher builds for one of their groups.
// Kept apart from the seeded `quizzes` tables on purpose: the seed loader treats any
// quiz missing from the seed files as a blocking error. Owners and groups are
// referenced by key (demo staff and demo groups are defined in code, staff/demo-org.ts).
// Status is derived, never stored: draft (publishedAt null), scheduled, live, closed.

enum AssessmentPurpose {
  CHECK
  RETEST
  DIAGNOSTIC
}

enum AnswerReveal {
  AFTER_CLOSE
  AFTER_SUBMIT
  NEVER
}

/// Who takes it: the whole group, or only students under 60% on the topic in the latest diagnostic
enum AssessmentAudience {
  CLASS
  UNDER_60
}

model Assessment {
  id               String             @id @default(cuid())
  /// The owning teacher: staff slug ("dilshod-karimov") or "acct:<accountId>"
  ownerKey         String
  /// Demo group code ("B-12") or a StudyGroup joinCode
  groupCode        String
  subjectSlug      String
  topicSlug        String?
  title            String
  description      String?
  purpose          AssessmentPurpose
  languages        Locale[]
  audience         AssessmentAudience @default(CLASS)
  opensAt          DateTime?
  closesAt         DateTime?
  /// Null = no time limit
  timeLimitMinutes Int?
  attemptsAllowed  Int                @default(1)
  revealAnswers    AnswerReveal       @default(AFTER_CLOSE)
  xp               Int                @default(40)
  shuffleQuestions Boolean            @default(true)
  shuffleOptions   Boolean            @default(true)
  notifyStudents   Boolean            @default(true)
  /// Null while it is a draft
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  questions AssessmentQuestion[]

  @@index([ownerKey])
  @@map("assessments")
}

/// A question snapshot: bank questions are copied, so later content edits never change a published assessment.
model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order        Int
  topicSlug    String
  /// Set when copied from the question bank: quiz slug and question key
  sourceQuiz   String?
  sourceKey    String?
  /// Markdown per locale: { en, ru?, tg? }
  prompt       Json
  code         String?
  /// [{ text: { en, ru?, tg? } }]
  options      Json
  correctIndex Int
  /// Markdown per locale
  explanation  Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, order])
  @@map("assessment_questions")
}

// ---------- Center staff invitations and permissions (Faroz, 2026-10-29, owner-approved migration) ----------
// A center is referenced by key: "demo-center" for the code-defined Faroz Demo Center,
// "org:<organizationId>" for a center admin account. No email is sent: the admin copies
// the link. Only the SHA-256 of the link token is stored. Status is derived:
// revoked → accepted → declined → expired (expiresAt passed) → pending.

model StaffInvitation {
  id                String      @id @default(cuid())
  orgKey            String
  /// Shown on the invitation page
  orgName           String
  /// SHA-256 (hex) of the token in the link; the token itself is never stored
  tokenHash         String      @unique
  name              String
  /// Lower-case; the accepting account must have this email
  email             String
  /// TEACHER only for now (no coordinator accounts yet)
  role              AccountRole
  subject           String
  /// Language the invitation page opens in
  locale            Locale
  /// Staff slug or "acct:<accountId>" of the inviter
  invitedByKey      String
  invitedByName     String
  expiresAt         DateTime
  acceptedAt        DateTime?
  acceptedAccountId String?
  acceptedAccount   Account?    @relation(fields: [acceptedAccountId], references: [id], onDelete: SetNull)
  declinedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([orgKey])
  @@index([acceptedAccountId])
  @@map("staff_invitations")
}

/// Coordinator and teacher permissions set by the center admin (handoff §7). No row = handoff defaults.
model CenterPermissions {
  orgKey       String   @id
  coordGroups  Boolean  @default(true)
  coordStaff   Boolean  @default(true)
  teachCreate  Boolean  @default(true)
  teachShare   Boolean  @default(false)
  updatedByKey String
  updatedAt    DateTime @updatedAt

  @@map("center_permissions")
}

// ---------- Communications: chat, voice messages, calls (Faroz, 2026-10-29, owner-approved) ----------
// Participants are referenced by key, like the rest of the staff data: a learner is "user:<userId>",
// a staff member "staff:<slug>" (demo staff slug, or "acct:<accountId>" for password accounts).
// Who may talk to whom is decided in code from the group rosters (comms/directory), never stored:
// a direct conversation holds its two keys; a group conversation follows the group's live roster.
// Centers never read conversations (privacy: group totals and participation only).

enum ConversationKind {
  DIRECT
  GROUP
}

enum MessageKind {
  TEXT
  VOICE
  /// Call log line: body is JSON {"media":"audio"|"video","event":"started"|"ended","seconds"?:n}
  CALL
}

model Conversation {
  id            String           @id @default(cuid())
  /// "dm:<keyA>|<keyB>" (keys sorted), "group:demo:<code>" / "group:db:<studyGroupId>", or "group:custom:<uuid>" (a teacher's own group chat)
  key           String           @unique
  kind          ConversationKind
  /// Group name when it was created (direct conversations show the other person instead)
  title         String?
  lastMessageAt DateTime?
  /// Who created a custom group chat (the teacher who manages it)
  createdByKey  String?
  createdAt     DateTime         @default(now())

  messages Message[]
  reads    ConversationRead[]
  members  ConversationMember[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderKey      String
  /// Name at sending time, so history stays readable if a demo name changes
  senderName     String
  kind           MessageKind
  /// Text, or the CALL JSON; null for voice
  body           String?
  createdAt      DateTime     @default(now())

  voice VoiceClip?

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Audio of a voice message (webm/opus or mp4/aac), at most 2 MB; served only to the conversation's members.
model VoiceClip {
  messageId  String  @id
  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mimeType   String
  durationMs Int
  data       Bytes

  @@map("voice_clips")
}

/// Last time a participant read a conversation (unread counts).
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participantKey String
  lastReadAt     DateTime
  /// "Delete chat" for me: messages up to here are hidden for this participant
  clearedAt      DateTime?

  @@id([conversationId, participantKey])
  @@index([participantKey])
  @@map("conversation_reads")
}

/// Changes to who is in a group chat, made by its teacher: added people, or roster members taken out
/// (removed = true). A custom group chat's members are all rows here. Study group rosters are not changed.
model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participantKey String
  removed        Boolean      @default(false)
  changedByKey   String
  updatedAt      DateTime     @updatedAt

  @@id([conversationId, participantKey])
  @@index([participantKey])
  @@map("conversation_members")
}
