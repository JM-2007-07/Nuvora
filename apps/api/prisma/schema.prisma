// Nuvora database schema (Prisma 7.10.1), Gate G2.
// Spec: docs/04-data/data-model.md. MVP entities only, no "Later" tables.
// The connection URL lives in prisma.config.ts.
//
// Conventions:
// - ids are cuid strings; tables are snake_case plural (@@map).
// - Localized text is jsonb `{ tg, ru, en }`, validated with Zod (ADR-0003).
// - Content slugs are unique per entity type; questions, options and resources
//   have keys unique within their parent, so re-seeding upserts instead of duplicating.
// - Deletion policy (data-model.md#deletion-policy): content deletes cascade to other
//   content, but every learner-history row references content with ON DELETE RESTRICT,
//   so content with history cannot be deleted. Deleting a user cascades to their history.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (must match packages/shared/src/enums.ts) ----------

enum Locale {
  tg
  ru
  en
}

enum UserKind {
  DEMO
  GUEST
}

enum QuizKind {
  TOPIC
  CHECKPOINT
}

enum QuestionType {
  SINGLE_CHOICE
}

enum ResourceType {
  BOOK
  ARTICLE
  VIDEO
  EXERCISE
}

enum MasteryStatus {
  NOT_STARTED
  WEAK
  DEVELOPING
  MASTERED
}

// ---------- Content (authored in seed files, read-only at runtime) ----------

model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       Json
  description Json
  order       Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics  Topic[]
  quizzes Quiz[]

  @@map("subjects")
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  slug      String   @unique
  title     Json
  summary   Json
  order     Int
  /// Knowledge Map column (prerequisite depth), D-09
  mapX      Int
  /// Knowledge Map row within the column
  mapY      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject       Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// Rows where this topic requires another topic
  prerequisites TopicPrerequisite[] @relation("TopicRequires")
  /// Rows where this topic is required by another topic
  dependents    TopicPrerequisite[] @relation("TopicRequiredBy")
  lessons       Lesson[]
  resources     Resource[]
  quizzes       Quiz[]
  questions     Question[]
  masteries     TopicMastery[]

  @@index([subjectId, order])
  @@map("topics")
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic        Topic @relation("TopicRequires", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite Topic @relation("TopicRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("topic_prerequisites")
}

model Lesson {
  id               String   @id @default(cuid())
  topicId          String
  slug             String   @unique
  title            Json
  /// Markdown per locale (D-12)
  body             Json
  estimatedMinutes Int
  order            Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  topic    Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([topicId, order])
  @@map("lessons")
}

model Resource {
  id        String       @id @default(cuid())
  topicId   String
  key       String
  type      ResourceType
  title     Json
  author    String
  url       String?
  /// Languages the resource itself is available in
  languages Locale[]
  whyUseful Json
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, key])
  @@map("resources")
}

model Quiz {
  id        String   @id @default(cuid())
  subjectId String
  /// Set for TOPIC quizzes; null for a CHECKPOINT quiz spanning several topics
  topicId   String?
  slug      String   @unique
  title     Json
  kind      QuizKind
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic     Topic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([subjectId])
  @@index([topicId])
  @@map("quizzes")
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  /// The topic this question assesses (drives weak-topic analysis)
  topicId     String
  key         String
  type        QuestionType @default(SINGLE_CHOICE)
  /// Markdown per locale
  prompt      Json
  /// Markdown per locale
  explanation Json
  order       Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic   Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options AnswerOption[]
  answers AttemptAnswer[]

  @@unique([quizId, key])
  @@index([topicId])
  @@map("questions")
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  key        String
  text       Json
  /// Never sent to clients before submission (FR-QUIZ-06)
  isCorrect  Boolean
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@unique([questionId, key])
  @@map("answer_options")
}

// ---------- Learner data (written at runtime) ----------

model User {
  id              String   @id @default(cuid())
  kind            UserKind
  /// Set for seeded demo learners only (ADR-0006)
  demoSlug        String?  @unique
  displayName     String
  preferredLocale Locale?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempts       QuizAttempt[]
  masteries      TopicMastery[]
  lessonProgress LessonProgress[]

  @@map("users")
}

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  submittedAt  DateTime @default(now())
  correctCount Int
  totalCount   Int
  /// Integer 0–100
  scorePercent Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: content deletion must never erase learner history (deletion policy, data-model.md)
  quiz      Quiz            @relation(fields: [quizId], references: [id], onDelete: Restrict)
  answers   AttemptAnswer[]
  masteries TopicMastery[]

  @@index([userId, submittedAt])
  @@index([quizId])
  @@map("quiz_attempts")
}

model AttemptAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  /// Stored at scoring time so history survives later content edits
  isCorrect        Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempt        QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// Restrict: content deletion must never erase learner history (deletion policy, data-model.md)
  question       Question      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption AnswerOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("attempt_answers")
}

model TopicMastery {
  id            String        @id @default(cuid())
  userId        String
  topicId       String
  /// Integer 0–100, from the latest attempt that included the topic (ADR-0004)
  scorePercent  Int
  status        MasteryStatus
  lastAttemptId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: content deletion must never erase learner history (deletion policy, data-model.md)
  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Restrict)
  lastAttempt QuizAttempt? @relation(fields: [lastAttemptId], references: [id], onDelete: SetNull)

  @@unique([userId, topicId])
  @@index([topicId])
  @@map("topic_masteries")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: content deletion must never erase learner history (deletion policy, data-model.md)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}
