{
  "name": "@nuvora/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Zod schemas, types, and constants for Nuvora",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
